00:00000384 423900FF9802    	    21:         clr.b   (INPUT_RELEASED).l
00:0000038A 423900FF9803    	    22:         clr.b   (INPUT_RAW_HIGH).l
00:00000390 423900FF9804    	    23:         clr.b   (INPUT_RAW_LOW).l
00:00000396 423900FF9805    	    24:         clr.b   (INPUT_CONNECTED).l
