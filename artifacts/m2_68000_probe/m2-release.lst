Source: "hardware\controllers.asm"
                            	     1: ; Standard three-button controller port 1 support. The bounded VBlank handler
                            	     2: ; calls ControllerPoll exactly once after acknowledging the VDP.
                            	     3: 
                            	     4: CONTROLLER_TH_OUTPUT            equ     $40
                            	     5: CONTROLLER_PHASE_HIGH           equ     $40
                            	     6: CONTROLLER_PHASE_LOW            equ     $00
                            	     7: 
                            	     8: INPUT_BIT_UP                    equ     $01
                            	     9: INPUT_BIT_DOWN                  equ     $02
                            	    10: INPUT_BIT_LEFT                  equ     $04
                            	    11: INPUT_BIT_RIGHT                 equ     $08
                            	    12: INPUT_BIT_A                     equ     $10
                            	    13: INPUT_BIT_B                     equ     $20
                            	    14: INPUT_BIT_C                     equ     $40
                            	    15: 
                            	    16: ControllerInitialize:
00:00000368 13FC004000A10009	    17:         move.b  #CONTROLLER_TH_OUTPUT,(IO_PORT1_CONTROL).l
00:00000370 13FC004000A10003	    18:         move.b  #CONTROLLER_PHASE_HIGH,(IO_PORT1_DATA).l
00:00000378 423900FF9800    	    19:         clr.b   (INPUT_HELD).l
