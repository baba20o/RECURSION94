Source: "hardware\z80_bus.asm"
                            	     1: ; Leave the sound CPU held in reset for Milestone 1. The bus request is bounded,
                            	     2: ; and a timeout is published rather than permitting an unbounded boot hang.
                            	     3: 
                            	     4: Z80_BUS_TIMEOUT                 equ     $3FFF
                            	     5: 
                            	     6: Z80EnterSafeState:
00:00000322 33FC010000A11100	     7:         move.w  #$0100,(Z80_BUS_REQUEST).l
                            	     8: ; Power-on reset must be cancelled for the BUSREQ acknowledge circuit to run.
                            	     9: ; BUSREQ is already asserted, so the Z80 cannot execute unowned sound code.
00:0000032A 33FC010000A11200	    10:         move.w  #$0100,(Z80_RESET).l
00:00000332 303C3FFE        	    11:         move.w  #Z80_BUS_TIMEOUT-1,d0
                            	    12: .wait_for_bus:
00:00000336 7200            	    13:         moveq   #0,d1
00:00000338 123900A11100    	    14:         move.b  (Z80_BUS_REQUEST).l,d1
00:0000033E 02010001        	    15:         andi.b  #$01,d1
00:00000342 6710            	    16:         beq.s   .bus_owned
00:00000344 51C8FFF0        	    17:         dbf     d0,.wait_for_bus
00:00000348 0079000100FFF01A	    18:         ori.w   #HARDWARE_FLAG_Z80_TIMEOUT,(DEBUG_HARDWARE_FLAGS).l
00:00000350 7001            	    19:         moveq   #1,d0
00:00000352 6002            	    20:         bra.s   .release_bus
                            	    21: .bus_owned:
00:00000354 7000            	    22:         moveq   #0,d0
                            	    23: .release_bus:
00:00000356 33FC000000A11200	    24:         move.w  #$0000,(Z80_RESET).l
00:0000035E 33FC000000A11100	    25:         move.w  #$0000,(Z80_BUS_REQUEST).l
00:00000366 4E75            	    26:         rts
                            	    27: 

