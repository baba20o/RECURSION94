Source: "boot\startup.asm"
                            	     1: ; Reset owns initialization. Interrupts remain masked and the display remains
                            	     2: ; disabled until all RAM and video state is deterministic.
                            	     3: 
                            	     4: ResetEntry:
00:00000200 46FC2700        	     5:         move.w  #$2700,sr
00:00000204 2E7C00FFFFFC    	     6:         move.l  #INITIAL_STACK,a7
                            	     7: 
                            	     8: ; Clear all 64 KiB without using the stack. The reset entry has no stack frame.
00:0000020A 207C00FF0000    	     9:         move.l  #WORK_RAM_BASE,a0
00:00000210 7000            	    10:         moveq   #0,d0
00:00000212 323C3FFF        	    11:         move.w  #WORK_RAM_LONGS-1,d1
                            	    12: .clear_work_ram:
00:00000216 20C0            	    13:         move.l  d0,(a0)+
00:00000218 51C9FFFC        	    14:         dbf     d1,.clear_work_ram
00:0000021C 2E7C00FFFFFC    	    15:         move.l  #INITIAL_STACK,a7
                            	    16: 
                            	    17: ; Publish the minimum stable debug ABI before calling any hardware routine.
00:00000222 23FC5239344400FF	    18:         move.l  #DEBUG_MAGIC_R94D,(DEBUG_MAGIC).l
00:0000022A F000
00:0000022C 33FC000100FFF004	    19:         move.w  #DEBUG_ABI_VERSION_VALUE,(DEBUG_ABI_VERSION).l
00:00000234 33FC040000FFF006	    20:         move.w  #DEBUG_ABI_SIZE_VALUE,(DEBUG_ABI_SIZE).l
00:0000023C 33FC000100FFF018	    21:         move.w  #BOOT_STAGE_RAM_READY,(DEBUG_BOOT_STAGE).l
                            	    22: 
                            	    23: ; TMSS-equipped hardware exposes a nonzero low version nibble.
00:00000244 7000            	    24:         moveq   #0,d0
00:00000246 103900A10001    	    25:         move.b  (HW_VERSION).l,d0
00:0000024C 0200000F        	    26:         andi.b  #$0F,d0
00:00000250 670A            	    27:         beq.s   .tmss_complete
00:00000252 23FC5345474100A1	    28:         move.l  #$53454741,(TMSS_REGISTER).l
00:0000025A 4000
                            	    29: .tmss_complete:
                            	    30: 
00:0000025C 610000C4        	    31:         bsr.w   Z80EnterSafeState
00:00000260 33FC000200FFF018	    32:         move.w  #BOOT_STAGE_Z80_SAFE,(DEBUG_BOOT_STAGE).l
                            	    33: 
00:00000268 610000FE        	    34:         bsr.w   ControllerInitialize
00:0000026C 61000280        	    35:         bsr.w   VdpInitialize
00:00000270 61000B2E        	    36:         bsr.w   VdpLoadDiagnostic
00:00000274 610003E8        	    37:         bsr.w   DmaInitialize
00:00000278 61000946        	    38:         bsr.w   SpriteInitialize
00:0000027C 33FC000300FFF018	    39:         move.w  #BOOT_STAGE_VIDEO_READY,(DEBUG_BOOT_STAGE).l
                            	    40: 
                            	    41: ; Clear a possibly pending VDP interrupt, then enable display/V-int and lower
                            	    42: ; the CPU mask only far enough to admit the level-6 VBlank interrupt.
00:00000284 303900C00004    	    43:         move.w  (VDP_CONTROL).l,d0
00:0000028A 33FC816400C00004	    44:         move.w  #VDP_REGISTER_DISPLAY_ON,(VDP_CONTROL).l
00:00000292 33FC000400FFF018	    45:         move.w  #BOOT_STAGE_RUNNING,(DEBUG_BOOT_STAGE).l
00:0000029A 46FC2500        	    46:         move.w  #$2500,sr
                            	    47: 
                            	    48: MainLoop:
                            	    49: ; Mask VBlank only while testing/decrementing the shared token. STOP lowers the
                            	    50: ; mask and sleeps atomically, so an interrupt can never be lost between the
                            	    51: ; empty-token test and sleep.
00:0000029E 46FC2700        	    52:         move.w  #$2700,sr
00:000002A2 4A7900FFF014    	    53:         tst.w   (DEBUG_FRAME_TOKEN).l
00:000002A8 6710            	    54:         beq.s   .wait_for_vblank
00:000002AA 537900FFF014    	    55:         subq.w  #1,(DEBUG_FRAME_TOKEN).l
00:000002B0 61000A4A        	    56:         bsr.w   M2DebugFatalFixture
00:000002B4 6100096C        	    57:         bsr.w   SpriteUpdateAndQueue
00:000002B8 60E4            	    58:         bra.s   MainLoop
                            	    59: .wait_for_vblank:
00:000002BA 4E722500        	    60:         stop    #$2500
00:000002BE 60DE            	    61:         bra.s   MainLoop
                            	    62: 

