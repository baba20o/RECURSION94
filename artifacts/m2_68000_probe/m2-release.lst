                            	     1: ; Explicit Debug-only fatal-screen fixture. Holding Start+A+B+C in the live
                            	     2: ; controller sample executes one illegal instruction exactly once.
                            	     3: 
                            	     4: M2_FATAL_FIXTURE_TRIGGERED      equ     INPUT_STATE_BASE+$0C
                            	     5: M2_FATAL_FIXTURE_BUTTONS        equ     INPUT_BIT_A+INPUT_BIT_B+INPUT_BIT_C
                            	     6: 
                            	     7: M2DebugFatalFixture:
                            	     8:         ifd     BUILD_DEBUG
                            	     9:         tst.b   (M2_FATAL_FIXTURE_TRIGGERED).l
                            	    10:         bne.s   .complete
                            	    11:         tst.b   (INPUT_START_HELD).l
                            	    12:         beq.s   .complete
                            	    13:         moveq   #0,d0
                            	    14:         move.b  (INPUT_HELD).l,d0
                            	    15:         andi.b  #M2_FATAL_FIXTURE_BUTTONS,d0
                            	    16:         cmpi.b  #M2_FATAL_FIXTURE_BUTTONS,d0
                            	    17:         bne.s   .complete
                            	    18:         move.b  #$01,(M2_FATAL_FIXTURE_TRIGGERED).l
                            	    19:         illegal
                            	    20: .complete:
                            	    21:         endif
00:00000CFC 4E75            	    22:         rts
                            	    23: 

