Source: "boot\exceptions.asm"
                            	     1: ; Common fatal sink for every exception and interrupt not explicitly owned.
                            	     2: ; It is safe before VDP initialization and never returns into damaged state.
                            	     3: 
                            	     4: SafeException:
00:000002C0 46FC2700        	     5:         move.w  #$2700,sr
00:000002C4 7000            	     6:         moveq   #0,d0
00:000002C6 0CB95239344400FF	     7:         cmpi.l  #DEBUG_MAGIC_R94D,(DEBUG_MAGIC).l
00:000002CE F000
00:000002D0 6620            	     8:         bne.s   .publish_fatal
00:000002D2 0C79000100FFF004	     9:         cmpi.w  #DEBUG_ABI_VERSION_VALUE,(DEBUG_ABI_VERSION).l
00:000002DA 6616            	    10:         bne.s   .publish_fatal
00:000002DC 0C79040000FFF006	    11:         cmpi.w  #DEBUG_ABI_SIZE_VALUE,(DEBUG_ABI_SIZE).l
00:000002E4 660C            	    12:         bne.s   .publish_fatal
00:000002E6 0C79000300FFF018	    13:         cmpi.w  #BOOT_STAGE_VIDEO_READY,(DEBUG_BOOT_STAGE).l
00:000002EE 6502            	    14:         blo.s   .publish_fatal
00:000002F0 7001            	    15:         moveq   #1,d0
                            	    16: 
                            	    17: .publish_fatal:
00:000002F2 23FC5239344400FF	    18:         move.l  #DEBUG_MAGIC_R94D,(DEBUG_MAGIC).l
00:000002FA F000
00:000002FC 33FC000100FFF004	    19:         move.w  #DEBUG_ABI_VERSION_VALUE,(DEBUG_ABI_VERSION).l
00:00000304 33FC040000FFF006	    20:         move.w  #DEBUG_ABI_SIZE_VALUE,(DEBUG_ABI_SIZE).l
00:0000030C 33FC000100FFF016	    21:         move.w  #FATAL_UNEXPECTED_EXCEPTION,(DEBUG_FATAL_CODE).l
00:00000314 4A00            	    22:         tst.b   d0
00:00000316 6704            	    23:         beq.s   SafeExceptionHalt
00:00000318 6100025A        	    24:         bsr.w   VdpShowFatalScreen
                            	    25: 
                            	    26: SafeExceptionHalt:
00:0000031C 4E722700        	    27:         stop    #$2700
00:00000320 60FA            	    28:         bra.s   SafeExceptionHalt
                            	    29: 

