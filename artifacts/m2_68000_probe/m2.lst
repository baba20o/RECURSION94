Source: "boot\exceptions.asm"
                            	     1: ; Common fatal sink for every exception and interrupt not explicitly owned.
                            	     2: ; It is safe before VDP initialization and never returns into damaged state.
                            	     3: 
                            	     4: SafeException:
00:000002BC 46FC2700        	     5:         move.w  #$2700,sr
00:000002C0 23FC5239344400FF	     6:         move.l  #DEBUG_MAGIC_R94D,(DEBUG_MAGIC).l
00:000002C8 F000
00:000002CA 33FC000100FFF004	     7:         move.w  #DEBUG_ABI_VERSION_VALUE,(DEBUG_ABI_VERSION).l
00:000002D2 33FC040000FFF006	     8:         move.w  #DEBUG_ABI_SIZE_VALUE,(DEBUG_ABI_SIZE).l
00:000002DA 33FC000100FFF016	     9:         move.w  #FATAL_UNEXPECTED_EXCEPTION,(DEBUG_FATAL_CODE).l
00:000002E2 0C79000300FFF018	    10:         cmpi.w  #BOOT_STAGE_VIDEO_READY,(DEBUG_BOOT_STAGE).l
00:000002EA 6504            	    11:         blo.s   .halt
00:000002EC 6100025A        	    12:         bsr.w   VdpShowFatalScreen
                            	    13: .halt:
00:000002F0 4E722700        	    14:         stop    #$2700
00:000002F4 60FA            	    15:         bra.s   .halt
                            	    16: 

