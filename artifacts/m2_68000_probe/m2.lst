                            	     1: ; Bounded VDP DMA queue. Main-side producers publish complete 12-byte records;
                            	     2: ; only DmaCommitPreparedQueue, called by VBlank, touches the VDP DMA registers.
                            	     3: 
                            	     4: DMA_QUEUE_PUBLISHED_DEPTH       equ     DMA_QUEUE_BASE+$00
                            	     5: DMA_QUEUE_BUILD_DEPTH           equ     DMA_QUEUE_BASE+$02
                            	     6: DMA_QUEUE_BUILD_WORDS           equ     DMA_QUEUE_BASE+$04
                            	     7: DMA_QUEUE_COMMIT_WORDS          equ     DMA_QUEUE_BASE+$08
                            	     8: DMA_QUEUE_FRAME_PENDING         equ     DMA_QUEUE_BASE+$0A
                            	     9: DMA_QUEUE_RESERVED_0            equ     DMA_QUEUE_BASE+$0C
                            	    10: DMA_QUEUE_RESERVED_1            equ     DMA_QUEUE_BASE+$0E
                            	    11: DMA_QUEUE_ENTRIES               equ     DMA_QUEUE_BASE+$10
                            	    12: 
                            	    13: DMA_QUEUE_ENTRY_SOURCE          equ     $00
                            	    14: DMA_QUEUE_ENTRY_DESTINATION     equ     $04
                            	    15: DMA_QUEUE_ENTRY_WORDS           equ     $06
                            	    16: DMA_QUEUE_ENTRY_FLAGS           equ     $08
                            	    17: DMA_QUEUE_ENTRY_AGE             equ     $0A
                            	    18: DMA_QUEUE_ENTRY_BYTES           equ     $0C
                            	    19: 
                            	    20: DMA_FLAG_REQUIRED               equ     $8000
                            	    21: DMA_FLAG_PROCESSED              equ     $4000
                            	    22: DMA_PRIORITY_MASK               equ     $0003
                            	    23: DMA_PRIORITY_CRITICAL           equ     $0000
                            	    24: DMA_PRIORITY_HIGH               equ     $0001
                            	    25: DMA_PRIORITY_NORMAL             equ     $0002
                            	    26: DMA_PRIORITY_LOW                equ     $0003
                            	    27: DMA_PRIORITY_LEVELS             equ     4
                            	    28: 
                            	    29: DMA_ORDINARY_WORD_LIMIT         equ     2048
                            	    30: DMA_SOURCE_WINDOW_BYTES         equ     $00020000
                            	    31: DMA_BUSY_TIMEOUT                equ     $1FFF
                            	    32: VDP_REGISTER_DISPLAY_ON_DMA     equ     $8174
                            	    33: 
                            	    34: DMA_VRAM_DYNAMIC_START          equ     (DIAGNOSTIC_GRID_TILE+1)*32
                            	    35: DMA_VRAM_DYNAMIC_END            equ     VRAM_PLANE_A
                            	    36: DMA_VRAM_PLANE_A_END            equ     VRAM_WINDOW
                            	    37: DMA_VRAM_WINDOW_END             equ     VRAM_PLANE_B
                            	    38: DMA_VRAM_PLANE_B_END            equ     VRAM_SAT
                            	    39: DMA_VRAM_SAT_END                equ     VRAM_SAT+SAT_SHADOW_BYTES
