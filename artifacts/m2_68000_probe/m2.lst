                            	    41: 
                            	    42: DMA_QUEUE_STORAGE_END           equ     DMA_QUEUE_ENTRIES+(DMA_QUEUE_CAPACITY*DMA_QUEUE_ENTRY_BYTES)
                            	    43: 
                            	    44:         assert  DMA_QUEUE_STORAGE_END<=INPUT_STATE_BASE,"DMA queue must not overlap input state"
