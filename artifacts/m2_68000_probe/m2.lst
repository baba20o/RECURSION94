Source: "boot\vectors.asm"
                            	     1: ; The cartridge header begins at $100, so all 64 base 68000 vectors are
                            	     2: ; explicitly covered here. Unexpected exceptions enter a bounded safe halt.
                            	     3: 
                            	     4: VectorTable:
00:00000000 00FFFFFC        	     5:         dc.l    INITIAL_STACK
00:00000004 00000200        	     6:         dc.l    ResetEntry
00:00000008 000002BC        	     7:         dcb.l   28,SafeException
00:0000000C *
00:00000078 00000C80        	     8:         dc.l    VBlankInterrupt
00:0000007C 000002BC        	     9:         dc.l    SafeException
00:00000080 000002BC        	    10:         dcb.l   32,SafeException
00:00000084 *
                            	    11: VectorTableEnd:
                            	    12: 
                            	    13:         assert  VectorTable=$000000,"vector table must start at ROM offset $000000"
                            	    14:         assert  VectorTableEnd=$000100,"vector table must contain exactly 64 entries"
                            	    15: 

