Source: "hardware\controllers.asm"
                            	     1: ; Standard three-button controller port 1 support. The bounded VBlank handler
                            	     2: ; calls ControllerPoll exactly once after acknowledging the VDP.
                            	     3: 
                            	     4: CONTROLLER_TH_OUTPUT            equ     $40
                            	     5: CONTROLLER_PHASE_HIGH           equ     $40
                            	     6: CONTROLLER_PHASE_LOW            equ     $00
                            	     7: 
                            	     8: INPUT_BIT_UP                    equ     $01
                            	     9: INPUT_BIT_DOWN                  equ     $02
                            	    10: INPUT_BIT_LEFT                  equ     $04
                            	    11: INPUT_BIT_RIGHT                 equ     $08
                            	    12: INPUT_BIT_A                     equ     $10
                            	    13: INPUT_BIT_B                     equ     $20
                            	    14: INPUT_BIT_C                     equ     $40
                            	    15: 
                            	    16: ControllerInitialize:
00:0000033C 13FC004000A10009	    17:         move.b  #CONTROLLER_TH_OUTPUT,(IO_PORT1_CONTROL).l
00:00000344 13FC004000A10003	    18:         move.b  #CONTROLLER_PHASE_HIGH,(IO_PORT1_DATA).l
00:0000034C 423900FF9800    	    19:         clr.b   (INPUT_HELD).l
00:00000352 423900FF9801    	    20:         clr.b   (INPUT_PRESSED).l
00:00000358 423900FF9802    	    21:         clr.b   (INPUT_RELEASED).l
00:0000035E 423900FF9803    	    22:         clr.b   (INPUT_RAW_HIGH).l
00:00000364 423900FF9804    	    23:         clr.b   (INPUT_RAW_LOW).l
00:0000036A 423900FF9805    	    24:         clr.b   (INPUT_CONNECTED).l
00:00000370 423900FF9806    	    25:         clr.b   (INPUT_START_HELD).l
00:00000376 423900FF9807    	    26:         clr.b   (INPUT_PREVIOUS).l
00:0000037C 42B900FF9808    	    27:         clr.l   (INPUT_SAMPLE_COUNT).l
00:00000382 0079000100FFF03A	    28:         ori.w   #M2_FLAG_INPUT_ACTIVE,(DEBUG_M2_FLAGS).l
00:0000038A 4E75            	    29:         rts
                            	    30: 
                            	    31: ; VBlank-only hardware routine. Clobbers d0-d2. TH is returned high after
                            	    32: ; every bounded two-phase sample.
                            	    33: ControllerPoll:
00:0000038C 13FC004000A10003	    34:         move.b  #CONTROLLER_PHASE_HIGH,(IO_PORT1_DATA).l
00:00000394 4E71            	    35:         nop
00:00000396 4E71            	    36:         nop
00:00000398 4E71            	    37:         nop
00:0000039A 4E71            	    38:         nop
00:0000039C 7000            	    39:         moveq   #0,d0
00:0000039E 103900A10003    	    40:         move.b  (IO_PORT1_DATA).l,d0
